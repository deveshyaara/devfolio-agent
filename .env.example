# Server / Streamlit secrets only. Never use NEXT_PUBLIC_ for these variables.
GOOGLE_API_KEY=replace-in-secret-manager
GITHUB_USERNAME=your-github-username
PORTFOLIO_TOPIC=portfolio
# Separate LOGIN users granted devfolio_reader / devfolio_writer; TLS required.
SUPABASE_DB_URL=postgresql://reader:REPLACE@db.PROJECT.supabase.co:5432/postgres?sslmode=require
# Actions secret only; direct/session-mode pooler, NEVER transaction pooling.
SUPABASE_SYNC_DB_URL=postgresql://writer:REPLACE@db.PROJECT.supabase.co:5432/postgres?sslmode=require
GITHUB_TOKEN=
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_VERSION=2026-04
EMBEDDING_DIMENSIONS=768
CHAT_MODEL=gemini-3.5-flash
# Optional: must support native tool calling.
FALLBACK_CHAT_MODEL=gemma-4-26b-a4b-it
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.5
MY_NAME=Your Name
MY_LINKEDIN_URL=https://www.linkedin.com/in/your-profile
MY_RESUME_URL=https://your-portfolio.example/resume
MY_CALENDLY_LINK=https://calendly.com/your-profile
MY_PROFILE_PIC_URL=https://placehold.co/400x400
